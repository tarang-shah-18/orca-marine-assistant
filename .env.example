# ORCA — environment
#
# Every value here is OPTIONAL. With none of them set, the full multi-agent
# engine still runs: the planner, the specialists, the synthesis, the safety
# critique, the charts and all eleven languages are deterministic and local.
#
# ---------------------------------------------------------------------------
# Optional AI layer
# ---------------------------------------------------------------------------
# With a key set, Gemini does exactly two things:
#   1. rewrites the planner's rationale into clearer prose, and
#   2. rewrites the synthesised answer from the evidence ledger.
#
# It may ADD agents to the roster. It can never remove one, and it never
# computes a number — every figure on screen still comes from an agent.
# If the key is absent, invalid, or the API is down, the deterministic
# synthesiser is used and the answer is flagged `aiGenerated: false`.
#
# GEMINI_API_KEY is the canonical name. GOOGLE_API_KEY is also accepted.
# GEMINI_API_KEY=your-key-here

# Model override. Default: gemini-2.5-flash
# ORCA_GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for the Express API and the Vite dev middleware. Default: 3000
# PORT=3000

# Comma-separated list of origins allowed to call the API.
# Defaults to * (any origin) so the Expo client and the web client both work
# out of the box. Set this in any deployment that is reachable from the internet.
# APP_URL=https://orca.example.org

# Node environment. `production` serves dist/ and the bundled server.cjs.
# NODE_ENV=development

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Pin the engine's reference cycle to a fixed instant (ISO 8601) so a given
# answer is reproducible against a known snapshot. Unset → aligned to now.
# ORCA_DATA_CYCLE_PIN=2026-09-09T03:00:00.000Z

# Persist conversation sessions to this JSON file so a restart doesn't drop
# active conversations. Unset → in-memory only (current default).
# ORCA_SESSIONS_FILE=/var/lib/orca/sessions.json

# Chat rate limiting (per IP, sliding window). Defaults: 120 req / 60 s.
# ORCA_RATE_MAX=120
# ORCA_RATE_WINDOW_MS=60000

# Set to 1 only when running behind a reverse proxy (nginx/caddy). Makes the
# rate limiter trust X-Forwarded-For for the client IP. Keep unset when the
# process is directly exposed, so a client can't spoof its IP.
# ORCA_TRUST_PROXY=1

# Web-client API origin for split hosting (Vercel client + remote engine).
# Leave unset for the normal same-origin deploy. When set (build-time, Vite),
# it must be a full origin, e.g. https://orca-engine.onrender.com/api
# VITE_API_BASE=
